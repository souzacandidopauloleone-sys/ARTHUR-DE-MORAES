---
import { site } from '../config/site';
import IconeInstagram from './IconeInstagram.astro';

interface Props {
  compacto?: boolean;
}
const { compacto = false } = Astro.props;
---

<a
  class:list={['botao', { 'botao--compacto': compacto }]}
  href={site.instagram.url}
  target="_blank"
  rel="noopener"
  aria-label={compacto ? `Instagram oficial (${site.instagram.usuario}), abre em nova aba` : undefined}
>
  <IconeInstagram />
  <span class:list={{ 'sr-only': compacto }}>Instagram oficial</span>
  <span class="sr-only">(abre em nova aba)</span>
</a>

<style>
  .botao--compacto {
    min-height: 2.75rem;
    padding: 0.6rem 0.75rem;
  }
</style>
