---
import { rotuloResultado, formatarData, type Campeonato } from '../lib/campeonatos';

interface Props {
  campeonatos: Campeonato[];
  legenda: string;
}
const { campeonatos, legenda } = Astro.props;
---

<div class="tabela-rolagem" role="region" aria-label={legenda} tabindex="0">
  <table class="cartel">
    <caption class="sr-only">{legenda}</caption>
    <thead>
      <tr>
        <th scope="col">Data</th>
        <th scope="col">Evento</th>
        <th scope="col">Categoria</th>
        <th scope="col">Resultado</th>
      </tr>
    </thead>
    <tbody>
      {
        campeonatos.map((c) => (
          <tr class:list={[`resultado-${c.data.resultado}`]} data-revelar>
            <td class="data">
              <time datetime={c.data.data.toISOString().slice(0, 10)}>{formatarData(c.data.data)}</time>
            </td>
            <th scope="row" class="evento">
              {c.data.evento}
              {c.data.cidade && <span class="detalhe">{c.data.cidade}</span>}
            </th>
            <td class:list={['categoria', { 'sem-categoria': !c.data.modalidade && !c.data.categoria }]}>
              {[c.data.modalidade, c.data.categoria].filter(Boolean).join(' · ') || '—'}
            </td>
            <td class="resultado">
              <span>{rotuloResultado[c.data.resultado]}</span>
              {c.data.titulo && <span class="detalhe">{c.data.titulo}</span>}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* Respiro à esquerda para o fio dourado não ser cortado pela rolagem */
  .tabela-rolagem {
    overflow-x: auto;
    margin-left: -1rem;
    padding-left: 1rem;
  }

  .cartel {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  /* Colunas fixas: tabelas diferentes na mesma página ficam alinhadas */
  @media (min-width: 48em) {
    .cartel {
      table-layout: fixed;
      min-width: 44rem;
    }

    thead th:nth-child(1) {
      width: 14%;
    }

    thead th:nth-child(2) {
      width: 42%;
    }

    thead th:nth-child(3) {
      width: 24%;
    }

    thead th:nth-child(4) {
      width: 20%;
    }
  }

  thead th {
    padding: 0 1rem 0.75rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.35);
    color: var(--cinza);
    font-size: var(--t-sm);
    font-weight: 500;
    text-align: left;
  }

  td,
  tbody th {
    position: relative;
    padding: 1.1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--linha);
    text-align: left;
    vertical-align: top;
  }

  .data {
    color: var(--cinza);
    white-space: nowrap;
  }

  .evento {
    color: var(--branco);
    font-size: var(--t-md);
    font-weight: 700;
    font-stretch: 85%;
    line-height: 1.25;
  }

  .detalhe {
    display: block;
    margin-top: 0.2rem;
    color: var(--cinza);
    font-size: var(--t-sm);
    font-weight: 400;
    font-stretch: 100%;
  }

  .resultado {
    font-weight: 700;
    white-space: nowrap;
  }

  /* O dourado marca o pódio: barra cheia para o 1º lugar, fina para 2º e 3º */
  tr[class*='resultado-'] .data::before {
    content: '';
    position: absolute;
    left: -0.9rem;
    top: 1.1rem;
    bottom: 1.1rem;
    width: 0;
    background: var(--dourado);
  }

  tr.resultado-ouro .data::before {
    width: 4px;
  }

  tr.resultado-prata .data::before,
  tr.resultado-bronze .data::before {
    width: 2px;
    opacity: 0.6;
  }

  .resultado-ouro .resultado > span:first-child {
    color: var(--dourado);
  }

  .resultado-prata .resultado > span:first-child,
  .resultado-bronze .resultado > span:first-child {
    color: var(--branco);
  }

  .resultado-participacao .resultado,
  .resultado-a-disputar .resultado {
    color: var(--cinza);
    font-weight: 500;
  }

  /* O fio dourado é "desenhado" quando a linha entra na tela */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) tr[data-revelar] .data::before {
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.7s var(--ease) 0.35s;
    }

    :global(.js) tr[data-revelar]:global(.visivel) .data::before {
      transform: scaleY(1);
    }
  }

  /* Celular: cada luta vira um bloco empilhado */
  @media (max-width: 47.99em) {
    .cartel,
    .cartel tbody,
    .cartel tr {
      display: block;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .cartel tr {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.25rem 1rem;
      padding: 1.25rem 0 1.25rem 1rem;
      border-bottom: 1px solid var(--linha);
      position: relative;
    }

    .cartel td,
    .cartel tbody th {
      display: block;
      padding: 0;
      border: 0;
      position: static;
    }

    .evento {
      grid-column: 1 / -1;
      order: -1;
    }

    .data {
      order: 1;
    }

    .categoria {
      grid-column: 1 / -1;
      order: 0;
      color: var(--texto);
    }

    .resultado {
      order: 2;
      text-align: right;
    }

    tr[class*='resultado-'] .data::before {
      left: 0;
      top: 1.25rem;
      bottom: 1.25rem;
    }

    .tabela-rolagem {
      overflow: visible;
    }

    .sem-categoria {
      display: none !important;
    }
  }
</style>
