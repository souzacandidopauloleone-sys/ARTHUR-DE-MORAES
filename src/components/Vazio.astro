---
/*
 * Estado vazio. O visitante vê só a mensagem pública;
 * a instrução de preenchimento aparece apenas no ambiente local (npm run dev).
 */
interface Props {
  titulo: string;
  instrucao: string;
}
const { titulo, instrucao } = Astro.props;
---

<div class="vazio">
  <p class="titulo-vazio">{titulo}</p>
  {import.meta.env.DEV && <p>Para preencher: {instrucao}</p>}
</div>

<style>
  .vazio {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px dashed rgb(255 255 255 / 0.2);
    color: var(--cinza);
  }

  .titulo-vazio {
    margin-bottom: 0.4rem;
    color: var(--texto);
    font-weight: 700;
  }

  p:last-child {
    margin: 0;
  }
</style>
