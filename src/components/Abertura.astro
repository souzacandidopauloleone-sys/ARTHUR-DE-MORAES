---
import { getImage } from 'astro:assets';
import { site, nomeExibicao, pendente } from '../config/site';
import { abertura } from '../lib/midia';
import BotaoInstagram from './BotaoInstagram.astro';
import Cordas from './Cordas.astro';
import Pendente from './Pendente.astro';

const { atleta } = site;

// Direção de arte: foto vertical no celular, horizontal a partir do tablet.
const gerar = async (src: ImageMetadata, larguras: number[], formato: 'avif' | 'webp') =>
  getImage({ src, widths: larguras, format: formato, quality: 72 });

let fontes: { tipo: string; media?: string; srcset: string }[] | undefined;
let reserva: Awaited<ReturnType<typeof getImage>> | undefined;

if (abertura.horizontal && abertura.vertical) {
  fontes = [];
  for (const formato of ['avif', 'webp'] as const) {
    const vertical = await gerar(abertura.vertical, [480, 768, 1080], formato);
    const horizontal = await gerar(abertura.horizontal, [1280, 1920, 2560], formato);
    fontes.push(
      { tipo: `image/${formato}`, media: '(max-width: 47.99em)', srcset: vertical.srcSet.attribute },
      { tipo: `image/${formato}`, srcset: horizontal.srcSet.attribute },
    );
  }
  reserva = await getImage({ src: abertura.horizontal, width: 1920, format: 'jpg', quality: 75 });
}
const linhaCategoria = [atleta.modalidade, atleta.categoria, atleta.cidade].filter(Boolean).join(' · ');
---

<section class="abertura" aria-labelledby="nome-atleta">
  <div class="fundo">
    {
      fontes ? (
        <picture>
          {fontes.map((f) => (
            <source type={f.tipo} media={f.media} srcset={f.srcset} sizes="100vw" />
          ))}
          <img
            class="foto"
            src={reserva!.src}
            width={reserva!.attributes.width}
            height={reserva!.attributes.height}
            alt={abertura.alt}
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      ) : (
        <div class="foto foto-pendente">
          {import.meta.env.DEV && (
            <span>
              Foto da abertura pendente de aprovação
              <br />
              (src/assets/abertura/horizontal.jpg · atleta em ação, mínimo 2000 px)
            </span>
          )}
        </div>
      )
    }
    <div class="luz" aria-hidden="true"></div>
  </div>

  <div class="container conteudo">
    <Cordas class="cordas-abertura" />
    <h1 id="nome-atleta" class="nome">
      {nomeExibicao}
      <span class="sr-only">, atleta de {atleta.modalidade.toLowerCase()}</span>
    </h1>
    <p class="categoria">{linhaCategoria}</p>
    {
      pendente(atleta.apresentacao) ? (
        <Pendente texto="texto curto de apresentação esportiva (site.ts → atleta.apresentacao)" />
      ) : (
        <p class="apresentacao">{atleta.apresentacao}</p>
      )
    }
    <div class="botoes">
      <a class="botao botao--principal" href="/sobre/">Conheça a trajetória</a>
      <a class="botao" href="/patrocinio/">Seja patrocinador</a>
      <BotaoInstagram />
    </div>
  </div>
</section>

<style>
  .abertura {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
    min-height: 100svh;
    padding-block: 7rem clamp(2.5rem, 2rem + 3vw, 4.5rem);
    isolation: isolate;
    overflow: hidden;
  }

  .fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .fundo picture {
    position: absolute;
    inset: 0;
  }

  .fundo :global(.foto) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
  }

  .fundo .foto-pendente {
    align-items: start;
    padding-top: 8rem;
  }

  /* Luz lateral e profundidade: escurece a base e a esquerda para o nome respirar */
  .luz {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--preto) 0%, rgb(11 11 13 / 0.75) 30%, rgb(11 11 13 / 0) 65%),
      linear-gradient(to right, rgb(11 11 13 / 0.7) 0%, rgb(11 11 13 / 0) 55%),
      radial-gradient(ellipse 60% 50% at 78% 22%, rgb(212 175 55 / 0.1), transparent 70%);
  }

  .conteudo {
    display: grid;
    justify-items: start;
    min-width: 0;
  }

  :global(.cordas-abertura) {
    width: min(22rem, 70%);
    margin-bottom: 1.5rem;
  }

  /* O nome: Archivo Black extracondensada, enorme, alinhado à esquerda */
  .nome {
    max-width: 100%;
    /* Limitado também pela altura, para nomes longos caberem na primeira tela */
    font-size: clamp(3rem, min(13.5vw, 19svh), 13rem);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.86;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .categoria {
    margin: 1.25rem 0 0;
    color: var(--branco);
    font-size: var(--t-md);
    font-weight: 600;
    font-stretch: 85%;
  }

  .apresentacao,
  .conteudo :global(.pendente) {
    margin: 0.75rem 0 2rem;
    color: var(--texto);
    font-size: var(--t-md);
    line-height: 1.5;
    max-width: 34rem;
  }

  .conteudo :global(.pendente) {
    font-size: var(--t-sm);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Aproximação lenta da foto */
    .fundo :global(.foto) {
      animation: aproximar 14s var(--ease) both;
    }

    /* Entrada do nome: começa largo e se fecha até a forma condensada, como uma guarda */
    .nome {
      animation: guarda 1.3s var(--ease) 0.15s both;
    }

    .categoria,
    .apresentacao,
    .conteudo :global(.pendente),
    .botoes {
      animation: surgir 0.9s var(--ease) both;
    }

    .categoria {
      animation-delay: 0.95s;
    }

    .apresentacao,
    .conteudo :global(.pendente) {
      animation-delay: 1.05s;
    }

    .botoes {
      animation-delay: 1.15s;
    }

    :global(.cordas-abertura span) {
      transform-origin: left;
      animation: esticar 1.1s var(--ease) both;
    }

    :global(.cordas-abertura span:nth-child(2)) {
      animation-delay: 0.08s;
    }

    :global(.cordas-abertura span:nth-child(3)) {
      animation-delay: 0.16s;
    }
  }

  @keyframes aproximar {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1.0);
    }
  }

  @keyframes guarda {
    from {
      opacity: 0;
      font-stretch: 125%;
      letter-spacing: 0.06em;
      filter: blur(6px);
    }
    60% {
      opacity: 1;
      filter: blur(0);
    }
    to {
      opacity: 1;
      font-stretch: 62%;
      letter-spacing: -0.005em;
    }
  }

  @keyframes surgir {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes esticar {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
