---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página não encontrada" descricao="Esta página não existe ou mudou de endereço.">
  <header class="container cabecalho-pagina">
    <h1>Página não encontrada</h1>
    <p>Este endereço não existe ou mudou. Volte ao início para ver a trajetória e os campeonatos.</p>
    <div class="botoes">
      <a class="botao botao--principal" href="/">Voltar ao início</a>
    </div>
  </header>
</Base>

<style>
  .botoes {
    margin-top: 2rem;
  }
</style>
