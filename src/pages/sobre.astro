---
import Base from '../layouts/Base.astro';
import Pendente from '../components/Pendente.astro';
import { site, nomeExibicao } from '../config/site';
import { campeonatosConfirmados, podio } from '../lib/campeonatos';

const { historia, atleta } = site;

// Linha do tempo montada a partir dos campeonatos confirmados, agrupados por ano.
const campeonatos = (await campeonatosConfirmados()).filter((c) => c.data.resultado !== 'a-disputar');
const anos = [...new Set(campeonatos.map((c) => c.data.data.getUTCFullYear()))].sort();
const linhaDoTempo = anos.map((ano) => {
  const doAno = campeonatos.filter((c) => c.data.data.getUTCFullYear() === ano);
  return { ano, total: doAno.length, podios: doAno.filter(podio).length, eventos: doAno.map((c) => c.data.evento) };
});

const blocos = [
  { id: 'inicio', titulo: 'Início no kickboxing', paragrafos: historia.inicio, campo: 'historia.inicio' },
  { id: 'evolucao', titulo: 'Evolução', paragrafos: historia.evolucao, campo: 'historia.evolucao' },
  { id: 'objetivos', titulo: 'Objetivos', paragrafos: historia.objetivos, campo: 'historia.objetivos' },
].filter((b) => b.paragrafos.length || import.meta.env.DEV); // no site publicado, seção sem texto não aparece

const mostrarEquipe = Boolean(atleta.academia || atleta.treinador || import.meta.env.DEV);
---

<Base
  titulo="Sobre o atleta"
  descricao={`A história de ${nomeExibicao} no kickboxing: início na modalidade, evolução, objetivos e equipe.`}
>
  <header class="container cabecalho-pagina">
    <h1>Sobre o atleta</h1>
    {historia.resumo && <p>{historia.resumo}</p>}
  </header>

  {
    blocos.map((b) => (
      <section class="secao container bloco" aria-labelledby={`t-${b.id}`}>
        <h2 id={`t-${b.id}`} class="subtitulo" data-revelar>
          {b.titulo}
        </h2>
        <div data-revelar>
          {b.paragrafos.length ? (
            b.paragrafos.map((p) => <p>{p}</p>)
          ) : (
            <Pendente texto={`texto em site.ts → ${b.campo}`} />
          )}
        </div>
      </section>
    ))
  }

  {mostrarEquipe && (
  <section class="secao container bloco" aria-labelledby="t-equipe">
    <h2 id="t-equipe" class="subtitulo" data-revelar>Equipe</h2>
    <div data-revelar>
      {
        atleta.academia || atleta.treinador ? (
          <dl class="equipe">
            {atleta.academia && (
              <div>
                <dt>Academia</dt>
                <dd>{atleta.academia}</dd>
              </div>
            )}
            {atleta.treinador && (
              <div>
                <dt>Treinador</dt>
                <dd>{atleta.treinador}</dd>
              </div>
            )}
          </dl>
        ) : (
          <Pendente texto="academia e treinador, após autorização deles (site.ts → atleta)" />
        )
      }
    </div>
  </section>
  )}

  {
    linhaDoTempo.length > 0 && (
      <section class="secao container" aria-labelledby="t-linha">
        <div class="cabecalho-secao">
          <h2 id="t-linha" class="titulo" data-revelar>
            Ano a ano
          </h2>
        </div>
        <ol class="linha">
          {linhaDoTempo.map((item) => (
            <li data-revelar>
              <span class="ano">{item.ano}</span>
              <p>
                {item.total} {item.total === 1 ? 'campeonato disputado' : 'campeonatos disputados'}
                {item.podios > 0 && (
                  <strong>
                    {' '}
                    · {item.podios} {item.podios === 1 ? 'pódio' : 'pódios'}
                  </strong>
                )}
              </p>
              <p class="eventos">{item.eventos.join(', ')}</p>
            </li>
          ))}
        </ol>
        <a class="botao" href="/campeonatos/">Ver o histórico completo</a>
      </section>
    )
  }
</Base>

<style>
  .bloco {
    display: grid;
    gap: 1.25rem;
  }

  .bloco p {
    font-size: 1.125rem;
    line-height: 1.65;
  }

  @media (min-width: 60em) {
    .bloco {
      grid-template-columns: 4fr 8fr;
    }
  }

  .equipe {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .equipe dt {
    color: var(--cinza);
    font-size: var(--t-sm);
  }

  .equipe dd {
    margin: 0;
    color: var(--branco);
    font-size: var(--t-lg);
    font-weight: 700;
    font-stretch: 85%;
  }

  /* Linha do tempo: um fio vertical com os anos */
  .linha {
    margin: 0 0 2.5rem;
    padding: 0 0 0 1.5rem;
    list-style: none;
    border-left: 1px solid rgb(255 255 255 / 0.25);
  }

  .linha li {
    position: relative;
    padding-bottom: 2.25rem;
  }

  .linha li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 4px);
    top: 0.7rem;
    width: 7px;
    height: 7px;
    background: var(--branco);
  }

  .ano {
    display: block;
    color: var(--branco);
    font-size: var(--t-xl);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .linha p {
    margin: 0.25rem 0 0;
  }

  .linha strong {
    color: var(--dourado);
  }

  .eventos {
    color: var(--cinza);
    font-size: var(--t-sm);
  }
</style>
