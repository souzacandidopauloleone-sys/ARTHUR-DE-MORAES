---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Vazio from '../components/Vazio.astro';
import { nomeExibicao } from '../config/site';
import { formatarData } from '../lib/campeonatos';

// Somente itens aprovados pelo responsável. Destaques primeiro, depois do mais recente ao mais antigo.
const itens = (await getCollection('galeria', (g) => g.data.aprovado)).sort(
  (a, b) =>
    Number(b.data.destaque) - Number(a.data.destaque) ||
    (b.data.data?.getTime() ?? 0) - (a.data.data?.getTime() ?? 0),
);

const grandes = await Promise.all(
  itens.map((i) => getImage({ src: i.data.imagem, width: 1800, format: 'webp', quality: 80 })),
);
---

<Base
  titulo="Galeria de lutas"
  descricao={`Fotos e vídeos de ${nomeExibicao} em combate, em campeonatos de kickboxing e em premiações.`}
>
  <header class="container cabecalho-pagina">
    <h1>Galeria de lutas</h1>
    <p>Combates, campeonatos e pódios. Somente registros esportivos.</p>
  </header>

  <div class="container">
    {
      itens.length === 0 ? (
        <Vazio
          titulo="As fotos e vídeos de luta serão publicados após aprovação."
          instrucao='coloque a imagem em src/assets/galeria/ e crie um .json em src/content/galeria/ (veja _modelo.json) com "aprovado": true.'
        />
      ) : (
        <ul class="galeria">
          {itens.map((item, i) => (
            <li class:list={{ destaque: item.data.destaque }} data-revelar>
              <figure>
                {item.data.tipo === 'video' && item.data.video ? (
                  <video
                    controls
                    preload="none"
                    playsinline
                    poster={grandes[i].src}
                    aria-label={item.data.alt}
                  >
                    <source src={item.data.video} type="video/mp4" />
                  </video>
                ) : (
                  <button type="button" class="ampliar" data-ampliar={grandes[i].src} data-alt={item.data.alt}>
                    <Image
                      src={item.data.imagem}
                      alt={item.data.alt}
                      widths={[400, 700, 1100]}
                      sizes="(min-width: 60em) 33vw, (min-width: 40em) 50vw, 100vw"
                      loading="lazy"
                    />
                    <span class="sr-only">Ampliar foto</span>
                  </button>
                )}
                <figcaption>
                  <span class="legenda">{item.data.legenda}</span>
                  <span class="meta">
                    {[item.data.evento, item.data.data && formatarData(item.data.data), item.data.credito]
                      .filter(Boolean)
                      .join(' · ')}
                  </span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <dialog class="visor" aria-label="Foto ampliada" data-visor>
    <img alt="" data-visor-img />
    <form method="dialog">
      <button class="botao fechar" type="submit">Fechar</button>
    </form>
  </dialog>
</Base>

<script>
  const visor = document.querySelector<HTMLDialogElement>('[data-visor]')!;
  const img = document.querySelector<HTMLImageElement>('[data-visor-img]')!;

  document.querySelectorAll<HTMLButtonElement>('[data-ampliar]').forEach((botao) => {
    botao.addEventListener('click', () => {
      img.src = botao.dataset.ampliar!;
      img.alt = botao.dataset.alt ?? '';
      visor.showModal();
    });
  });

  // Fecha ao clicar fora da foto
  visor.addEventListener('click', (e) => {
    if (e.target === visor) visor.close();
  });
</script>

<style>
  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    grid-auto-flow: dense;
    gap: 2.5rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40em) {
    .destaque {
      grid-column: span 2;
    }
  }

  figure {
    margin: 0;
  }

  .ampliar {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--grafite);
    cursor: zoom-in;
    overflow: hidden;
  }

  .ampliar :global(img),
  video {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .destaque .ampliar :global(img),
  .destaque video {
    aspect-ratio: 16 / 9;
  }

  @media (hover: hover) {
    .ampliar:hover :global(img) {
      transform: scale(1.03);
    }
  }

  figcaption {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.75rem;
  }

  .legenda {
    color: var(--branco);
    font-weight: 600;
  }

  .meta {
    color: var(--cinza);
    font-size: var(--t-sm);
  }

  .visor {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--gutter);
    border: 0;
    background: rgb(11 11 13 / 0.96);
  }

  .visor[open] {
    display: grid;
    place-items: center;
    gap: 1rem;
    grid-template-rows: 1fr auto;
  }

  .visor img {
    max-width: 100%;
    max-height: calc(100svh - 8rem);
    object-fit: contain;
  }

  .visor::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
</style>
