---
import Base from '../layouts/Base.astro';
import BotaoInstagram from '../components/BotaoInstagram.astro';
import Pendente from '../components/Pendente.astro';
import { site, nomeExibicao, whatsappLink } from '../config/site';

const { contato } = site;
const whatsapp = whatsappLink();
const assuntoEmail = encodeURIComponent(`Patrocínio — ${nomeExibicao}`);
---

<Base
  titulo="Contato"
  descricao={`Contato comercial para patrocínio e parcerias com ${nomeExibicao}, atleta de kickboxing.`}
>
  <header class="container cabecalho-pagina">
    <h1>Contato</h1>
    <p>
      Para patrocínio, parcerias e convites para eventos, fale com o responsável pelo atleta{
        contato.nomeResponsavel && `, ${contato.nomeResponsavel}`
      }.
    </p>
  </header>

  <section class="container canais" aria-label="Canais de contato">
    {
      contato.email || whatsapp ? (
        <div class="botoes">
          {whatsapp && (
            <a class="botao botao--principal" href={whatsapp} target="_blank" rel="noopener">
              Conversar pelo WhatsApp
              <span class="sr-only">(abre em nova aba)</span>
            </a>
          )}
          {contato.email && (
            <a class="botao" href={`mailto:${contato.email}?subject=${assuntoEmail}`}>
              Enviar e-mail
            </a>
          )}
        </div>
      ) : (
        <Pendente texto="e-mail e/ou WhatsApp comercial do responsável (site.ts → contato)" />
      )
    }

    {contato.email && <p class="email">{contato.email}</p>}

    <div class="instagram">
      <p>Acompanhe a rotina de treinos e competições:</p>
      <BotaoInstagram />
    </div>
  </section>
</Base>

<style>
  .canais {
    display: grid;
    gap: 2rem;
  }

  .email {
    color: var(--cinza);
  }

  .instagram {
    padding-top: 2rem;
    border-top: 1px solid var(--linha);
  }
</style>
